// Cloudflare Workers config: serves the built Vite app (dist/) as static assets.
// No Worker code runs; requests are answered straight from Cloudflare's asset store.
//
//   production: `wrangler deploy`               -> https://shift-planner.<subdomain>.workers.dev
//   staging:    `wrangler deploy --env staging` -> https://shift-planner-staging.<subdomain>.workers.dev
//
// The pipeline (.github/workflows/pipeline.yml) runs these; you don't need to.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shift-planner",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // One stable URL per environment; no per-deploy preview URLs to protect.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Any path that isn't a file gets index.html (single-page app).
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "shift-planner-staging",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
